{
  "name": "@rendezvous/core",
  "version": "0.1.0",
  "description": "Reference implementation of the Rendezvous agent-to-agent contact protocol",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:vectors:update": "UPDATE_VECTORS=1 vitest run test/vectors.test.ts"
  },
  "author": "Omer Nesher",
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "nostr-tools": "^2.25.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing/relay.js"
  }
}
