{
  "name": "rendezvous-impl",
  "private": true,
  "description": "npm workspace for the Rendezvous reference implementation",
  "type": "module",
  "workspaces": [
    "packages/core"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "test:vectors:update": "npm run test:vectors:update -w @rendezvous/core"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
