{
  "name": "rendezvous-impl",
  "private": true,
  "description": "npm workspace for the Rendezvous reference implementation",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/a2a",
    "packages/cli",
    "packages/mcp",
    "packages/gateway"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/a2a packages/cli packages/mcp packages/gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "test:vectors:update": "npm run test:vectors:update -w @rendezvous/core",
    "rdv": "node packages/cli/dist/src/bin.js",
    "rdv-mcp": "node packages/mcp/dist/src/bin.js",
    "rdv-gateway": "node packages/gateway/dist/src/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
