{
  "name": "@rendezvous/cli",
  "version": "0.1.0",
  "description": "rdv: command-line agent and scripted bots for the Rendezvous protocol",
  "author": "Omer Nesher",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./lib": {
      "types": "./dist/src/lib.d.ts",
      "default": "./dist/src/lib.js"
    }
  },
  "bin": {
    "rdv": "dist/src/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b ../core ../a2a && tsc -p tsconfig.json --noEmit",
    "test": "tsc -b && vitest run",
    "test:live": "tsc -b && vitest run --mode live",
    "scenario": "tsc -b && node dist/scenarios/contact.js",
    "scenario:dinner": "tsc -b && node dist/scenarios/dinner.js",
    "scenario:review": "tsc -b && node dist/scenarios/review.js",
    "scenario:microsite": "tsc -b && node dist/scenarios/microsite.js"
  },
  "dependencies": {
    "@rendezvous/a2a": "0.1.0",
    "@rendezvous/core": "0.1.0"
  }
}
