{
  "name": "@rendezvous/core",
  "version": "0.1.0",
  "description": "Reference implementation of the Rendezvous protocol for end-to-end encrypted agent-to-agent communication",
  "author": "Omer Nesher",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./safe-console": {
      "types": "./dist/safeconsole-install.d.ts",
      "default": "./dist/safeconsole-install.js"
    },
    "./testing": {
      "types": "./dist/testing/relay.d.ts",
      "default": "./dist/testing/relay.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:vectors:update": "node scripts/update-vectors.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "nostr-tools": "^2.25.2",
    "ws": "^8.22.0"
  }
}
