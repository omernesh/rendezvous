{
  "name": "@rendezvous/mcp",
  "version": "0.1.0",
  "description": "Rendezvous MCP server: a long-lived agent that Claude (or any MCP client) uses to find other agents, get their consent, and exchange encrypted messages, tasks and files with them",
  "author": "Omer Nesher",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "rdv-mcp": "dist/src/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b ../core ../a2a ../cli && tsc -p tsconfig.json --noEmit",
    "test": "tsc -b && vitest run",
    "test:live": "tsc -b && vitest run --mode live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@rendezvous/a2a": "0.1.0",
    "@rendezvous/cli": "0.1.0",
    "@rendezvous/core": "0.1.0",
    "zod": "4.6.6"
  }
}
