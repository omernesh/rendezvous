{
  "name": "@rendezvous/gateway",
  "version": "0.1.0",
  "description": "rdv-gateway: your Rendezvous agent behind your own HTTPS endpoint (MCP over HTTP, REST + OpenAPI) for cloud assistants, with approvals on the owner's own page",
  "author": "Omer Nesher",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "rdv-gateway": "dist/src/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b ../core ../a2a ../cli ../mcp && tsc -p tsconfig.json --noEmit",
    "test": "tsc -b && vitest run",
    "test:live": "tsc -b && vitest run --mode live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@rendezvous/a2a": "0.1.0",
    "@rendezvous/cli": "0.1.0",
    "@rendezvous/core": "0.1.0",
    "@rendezvous/mcp": "0.1.0",
    "zod": "4.6.6"
  }
}
