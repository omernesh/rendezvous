# Copy to .env (gitignored) and fill in. docker compose reads .env automatically.
# Leave a bind at 127.0.0.1 to keep that listener local. Never use 0.0.0.0.

# Private-network address (for example the host's Tailscale IP) and its port.
RELAY_BIND_TAILNET=127.0.0.1
RELAY_PORT_TAILNET=17777

# LAN address a tunnel connector (e.g. cloudflared) uses to reach the relay, and its port.
RELAY_BIND_LAN=127.0.0.1
RELAY_PORT_LAN=27777

# Where backup.sh writes strfry exports (local path or a mounted share).
BACKUP_DIR=/srv/backups/rendezvous-relay
